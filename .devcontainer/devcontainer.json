{
  "name": "Go Advanced",
  "image": "mcr.microsoft.com/devcontainers/go:1-1.24-bookworm",
  "customizations": {
    "vscode": {
      "extensions": ["golang.go"],
      "settings": {
        "go.toolsManagement.autoUpdate": true,
        "files.exclude": { "**/answer.go": false }
      }
    },
    "codespaces": {
      "openFiles": ["README.md"]
    }
  },
  "forwardPorts": [6060, 8080],
  "postCreateCommand": "go version && go env GOPATH"
}
